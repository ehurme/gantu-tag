        "voffset": "2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.0mm",
        "height": "1.0mm",
        "thickness": "0.18mm"
    },
    "text2": {
        "type": "simple",
        "text": "JLCJLCJLCJLC",
        "anchor": "mb",
        "voffset": "-2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.2mm",
        "height": "1.2mm",
        "thickness": "0.2mm"
    },
    "post": {
        "millradius": "0.5mm",
        "origin": "bl",
        "refillzones": true
    }
