{
    "layout": {
        "type": "grid",
        "rows": 2,
        "cols": 10,
        "hspace": "2mm",
        "vspace": "2mm",
        "renameref": "{orig}",
        "alternation": "rows"
    },
    "source": {
        "type": "auto",
        "tolerance": "6mm"
    },
    "tabs": {
        "type": "annotation",
        "tabfootprints": "insect_tag:KiKit_Tab_1p0mm, insect_tag:KiKit_Tab_1p2mm, insect_tag:KiKit_Tab_2p0mm, insect_tag:KiKit_Tab_3p0mm"
    },
    "cuts": {
        "type": "mousebites",
        "drill": "0.5mm",
        "spacing": "0.75mm",
        "offset": "-0.25mm",
        "prolong": "0.5mm"
    },
    "framing": {
        "type": "railstb",
        "width": "5mm",
        "space": "2mm",
        "cuts": "none"
    },
    "tooling": {
        "type": "4hole",
        "hoffset": "2.5mm",
        "voffset": "2.5mm",
        "size": "1.152mm",
        "soldermaskmargin": "1.3mm"
    },
    "fiducials": {
        "type": "3fid",
        "hoffset": "9mm",
        "voffset": "2.5mm",
        "coppersize": "1mm",
        "opening": "2mm"
    },
    "text": {
        "type": "simple",
        "text": "IN100 v8.2 D2 solar  S6:1-4 S6L:5-8 N6:9-10",
        "anchor": "mt",
        "voffset": "2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.2mm",
        "height": "1.2mm",
        "thickness": "0.2mm"
    },
    "text2": {
        "type": "simple",
        "text": "JLCJLCJLCJLC",
        "anchor": "mb",
        "voffset": "-2.5mm",
        "hjustify": "center",
        "vjustify": "center",
        "width": "1.2mm",
        "height": "1.2mm",
        "thickness": "0.2mm"
    },
    "post": {
        "millradius": "0.5mm",
        "origin": "bl",
        "refillzones": true
    }
}
