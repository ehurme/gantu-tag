(text "Irulu v9 larger-cell draft: choose the cell and enable parts after bench tests." (at 25.4 167.64 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid d2c29f43-058d-4b67-bf06-bd77857035c2))
(text "- U1: pilot QFN18 and VDDQ tied to VCC. Confirm DFN8 sourcing and programming before switching." (at 25.4 170.434 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid 95a05b1f-8be6-47af-b15a-120f75db54d0))
(text "- C1 100 uF 0805 (bursts), C4 100 nF at VDDQ (pin 13)." (at 25.4 173.228 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid a69b5d83-ac6b-42bc-be64-f1da05e43877))
(text "- CHIP_EN: R1 to VCC, C2 to GND. V1 1M/100nF (tau 0.1 s, slow start), V2 100k/10nF + JP1 OFF on the tail." (at 25.4 176.022 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid c8adac89-c309-4c8a-b09f-ef5cd602aeed))
(text "- Y1 26 MHz 1612, 7 pF, 80 ohm (IN100 spec 6-8 pF, 60-100 ohm): on-chip load capacitance." (at 25.4 178.816 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid 69187bd1-a61d-4e8a-a499-0cfbf4cc0ade))
(text "- AE1: wire from RF_TX. AE2: optional grounded wire for a dipole." (at 25.4 181.61 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid 13f82b89-7567-468e-8fc4-8d4a6abba81b))
(text "- BT1: 7.9-9.5 mm silver oxide. Insulate the positive pad and strap it to the can." (at 25.4 184.404 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid 97f4196c-fcdf-4e24-ad86-fc463f7bb742))
(text "- Program before fitting the cell: the programmer drives 3.3 V into VCC." (at 25.4 187.198 0) (effects (font (size 1.524 1.524)) (justify left bottom)) (uuid 1f63f636-bd81-4356-b232-318d3d410624))
